# Build artifacts
# Anchored: unanchored `build/` also swallowed app/build/, which is
# electron-builder's buildResources directory (icons, mac entitlements) and has
# to be tracked. The app's own outputs are ignored by app/.gitignore.
/build/
/build-hub/
*.uf2

# Zephyr workspace (auto-populated by west)
.west/
.cache/
zephyr/
modules/
bootloader/
tools/

# Python
*.pyc
__pycache__/
.venv/

# Sensor logs (raw + processed CSV — can be large)
logs/*.csv
