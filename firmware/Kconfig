mainmenu "MAID Wearable"

source "Kconfig.zephyr"

config MAID_IDLE_TIMEOUT_SEC
	int "Seconds of inactivity before deep sleep"
	default 10
	range 5 300
	help
	  The device enters deep sleep (system off, ~0.4 µA) after this many
	  consecutive seconds without gyroscope motion AND without a
	  validated skin-contact pulse (see firmware/src/contact.c) — worn
	  but still (e.g. resting) does not trigger sleep, only set down and
	  unworn does.
	  Wake-up is triggered by the LSM6DS3TR-C activity interrupt on INT1.
	  Change in prj.conf: CONFIG_MAID_IDLE_TIMEOUT_SEC=<value>
