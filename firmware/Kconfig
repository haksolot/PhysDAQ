mainmenu "PhysDAQ Wearable"

source "Kconfig.zephyr"

config PHYSDAQ_IDLE_TIMEOUT_SEC
	int "Seconds of inactivity before deep sleep"
	default 10
	range 5 300
	help
	  The device enters deep sleep (system off, ~0.4 µA) after this many
	  consecutive seconds with none of the three activity signals: no
	  gyroscope motion, no IR skin contact (see firmware/src/contact.c),
	  and no BLE connection. Worn but still (e.g. resting) does not
	  trigger sleep, and neither does a live host link — a node left
	  connected never sleeps, so disconnect it to let it go down.
	  Wake-up is triggered by the LSM6DS3TR-C activity interrupt on INT1.
	  Change in prj.conf: CONFIG_PHYSDAQ_IDLE_TIMEOUT_SEC=<value>
