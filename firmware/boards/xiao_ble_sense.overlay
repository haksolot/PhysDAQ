/*
 * XIAO BLE Sense overlay — MAID PPG + IMU
 *
 * I2C0 @ 0x6A : LSM6DS3TR-C IMU  (pinctrl: SDA=P0.07, SCL=P0.27; unchanged)
 * I2C1 @ 0x57 : MAX30102 PPG     (pinctrl: SDA=D4/P0.04, SCL=D5/P0.05)
 * D1  / P0.03 : MAX30102 INT (active LOW, open-drain, internal pull-up)
 *
 * The MAXREFDES117# eval board has no accessible EN/SHDN pin — the MAX30102
 * is always powered when VIN is connected.  No load-switch control needed.
 *
 * LED0 (P0.26 red), LED1 (P0.30 green), LED2 (P0.06 blue) are defined in
 * xiao_ble_common.dtsi and are not redefined here.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-adc.h>

/* Add MAX30102 child to the already-enabled I2C1 bus.
 * i2c1 uses nordic,nrf-twi with pinctrl already configured in
 * xiao_ble-pinctrl.dtsi (SDA=P0.04/D4, SCL=P0.05/D5). */
&i2c1 {
	clock-frequency = <I2C_BITRATE_STANDARD>;

	max30102: max30102@57 {
		compatible = "maxim,max30102";
		reg = <0x57>;
		int-gpios = <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		status = "okay";
	};
};

/*
 * VBAT sense circuit (Seeed XIAO nRF52840 Sense hardware, not in the
 * connector pin map): 1M / 510k divider to AIN7 (P0.31), gated by the
 * P0.14 read-enable pin. Keep P0.14 LOW except while sampling — driving
 * it HIGH disconnects the divider and can over-volt P0.31.
 */
/ {
	battery_divider: battery-divider {
		compatible = "voltage-divider";
		io-channels = <&adc 7>;
		output-ohms = <510000>;
		full-ohms = <(1000000 + 510000)>;
		power-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};
