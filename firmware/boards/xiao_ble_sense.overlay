/*
 * XIAO BLE Sense board overlay
 * Defines the onboard red LED on P0.26
 * Note: LSM6DS3TR-C IMU is already defined in xiao_ble_sense.dts (i2c0 @ 0x6A)
 */

/ {
    aliases {
        led0 = &led0;
    };

    leds {
        compatible = "gpio-leds";
        led0: led_0 {
            gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;
            label = "Red LED";
        };
    };
};
